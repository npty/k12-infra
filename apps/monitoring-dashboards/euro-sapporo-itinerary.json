      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"euro-sapporo-itinerary\",container!=\"\"}[5m]))",
