        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"euro-sapporo-itinerary\"} | filter \"Error\" | stats count()",
