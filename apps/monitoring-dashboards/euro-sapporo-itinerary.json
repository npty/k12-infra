    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU and memory",
      "description": "CPU (cores, left) and working-set memory (right) of namespace euro-sapporo-itinerary.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
