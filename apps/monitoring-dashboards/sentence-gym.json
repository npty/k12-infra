    {
      "id": 13,
      "type": "table",
      "title": "Actions leaderboard",
      "description": "How many times each action was performed, most used first.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"sentence-gym\"} event:user.action | stats by (action) count() times, count() if (outcome:failed) failed, quantile(0.5, duration_ms) p50, quantile(0.95, duration_ms) p95 | sort by (times desc) | limit 30",
          "queryType": "stats"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "action": 1,
              "times": 2,
              "failed": 3,
              "p50": 4,
              "p95": 5
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Waiting for user.action events",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "action"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Action"
              },
              {
                "id": "custom.width",
                "value": 230
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "times"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Times"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "displayName",
