    {
      "id": 13,
      "type": "table",
      "title": "By channel",
      "description": "Where questions come from and how fast each channel is answered.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "{kubernetes.pod_namespace=\"vegapunk\"} event:query.completed | stats by (channel) count() questions, count() if (outcome:failed) failed, quantile(0.5, duration_ms) p50, quantile(0.95, duration_ms) p95 | sort by (questions desc)",
          "queryType": "stats"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "channel": 1,
              "questions": 2,
              "failed": 3,
              "p50": 4,
              "p95": 5
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Waiting for query.completed events",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
